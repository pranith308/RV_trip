{
  "name": "RV_trip",
  "install": "npm ci",
  "start": "if [ -n \"${GOOGLE_MAPS_API_KEY:-}\" ] && [ ! -f .env ]; then printf 'GOOGLE_MAPS_API_KEY=%s\\n' \"$GOOGLE_MAPS_API_KEY\" > .env; fi",
  "ports": [
    {
      "name": "vite",
      "port": 5173
    }
  ],
  "terminals": [
    {
      "name": "dev",
      "command": "npm run dev",
      "description": "Vite development server on port 5173"
    }
  ]
}
